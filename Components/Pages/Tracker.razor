@page "/tracker"
@attribute [Authorize]

@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using the_fitness_assistant.Data
@using the_fitness_assistant.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using the_fitness_assistant.Services

@inject UserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider

@inject ApplicationDbContext Context

<PageTitle>Meal Tracker</PageTitle>

<h1>Meal Tracker</h1>

<div class="dates">
    <button>⬅️</button>
    <div class="selected-date">XX/XX/XXXX</div>
    <button>➡️</button>
</div>
    

<div class="tracker-card">
    <table>
        <tbody>
            <tr>
                <th>Breakfast</th>
                <td>
                    <ul>
                    @foreach (var entry in GetMeal("Breakfast"))
                    {
                        <li>
                            @entry.Food.Name (@entry.Servings serving(s))
                        </li>
                    }
                    </ul>
                </td>
                <td>
                    <button @onclick='() => OpenFoodForm("Breakfast")'>
                        Add Food
                    </button>
                </td>
                <td>@GetMealCalories("Breakfast")</td>
                
            </tr>
            <tr>
                <th>Lunch</th>
                <td>
                    <ul>
                        <li>food 1</li>
                    </ul>
                </td>
                <td>
                    <button @onclick='() => OpenFoodForm("Lunch")'>
                        Add Food
                    </button>
                </td>
                <td>(Calorie Total)</td>
            </tr>
            <tr>
                <th>Dinner</th>
                <td>
                    <ul>
                        <li>food 1</li>
                    </ul>
                </td>
                <td>
                    <button @onclick='() => OpenFoodForm("Dinner")'>
                        Add Food
                    </button>
                </td>
                <td>(Calorie Total)</td>
            </tr>
            <tr>
                <th>Snacks</th>
                <td>
                    <ul>
                        <li>food 1</li>
                    </ul>
                </td>
                <td>
                    <button @onclick='() => OpenFoodForm("Snacks")'>
                        Add Food
                    </button>
                </td>
                <td>(Calorie Total)</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="cal-total">
    Total Calories: @GetDailyCalories()
</div>

@if (showFoodForm)
{
    <div class="food-form">
        <h3>Add Food to @selectedMeal</h3>

        <button @onclick="CloseFoodForm">
            Cancel
        </button>
    </div>
}

@code {
    private List<FoodLogEntry> foodEntries = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        var currentUser = await UserService.EnsureUserExistsAsync(principal);

        int userId = currentUser.UserId;

        var today = DateTime.UtcNow.Date;
        var tomorrow = today.AddDays(1);

        foodEntries = await Context.FoodLogEntries
            .Include(f => f.Food)
            .Where(f =>
                f.UserId == userId &&
                f.LogDate >= today &&
                f.LogDate < tomorrow)
            .ToListAsync();
    }

    private IEnumerable<FoodLogEntry> GetMeal(string meal)
    {
        return foodEntries.Where(f => f.MealType == meal);
    }

    private double GetMealCalories(string meal)
    {
        return foodEntries
            .Where(f => f.MealType == meal)
            .Sum(f => f.Food.Calories * f.Servings);
    }

    private readonly string[] meals =
    {
        "Breakfast",
        "Lunch",
        "Dinner",
        "Snacks"
    };

    private double GetDailyCalories()
    {
        return foodEntries.Sum(f => f.Food.Calories * f.Servings);
    }

    private string? selectedMeal;
    private bool showFoodForm = false;

    private void OpenFoodForm(string meal)
    {
        selectedMeal = meal;
        showFoodForm = true;
    }

    private void CloseFoodForm()
    {
        selectedMeal = null;
        showFoodForm = false;
    }
}

@*The button for adding food will bring a form to either choose
from a list or add your own food to the database*@

@*The date selector will default to today and then go forward 
or back with the buttons on each side*@

@*The database should fill foods already logged for the user, 
and add all the calories from that meal to the total for the meal section*@

@*There will also be some option to remove food as a button somewhere*@

