@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <div class="login-box">
            <span class="login-label">Signed in as</span>
            <span class="login-name">@context.User.Identity?.Name</span>

            <form method="post" action="/logout" data-enhance="false">
                <button type="submit" class="login-btn">Logout</button>
            </form>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="login-box">
            <span class="login-label">Not signed in</span>

            <a class="login-btn" href="/login" data-enhance-nav="false">
                Login with Google
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>
