@page "/calculator"
@attribute [Authorize]

@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserService UserService
@inject ApplicationDbContext DbContext

<PageTitle>Calorie Calculator</PageTitle>

<h1>Calorie Calculator</h1>

<p>Find how many calories are needed to gain/maintain/lose weight</p>

<EditForm Model="@input" OnValidSubmit="@Calculate" FormName="CalorieCalculator">

    <DataAnnotationsValidator />

    <div class="calculator-card">
        <div class="form">
            <label>Gender:</label>
            <InputSelect @bind-Value="input.Gender">
                <option value="Male">Male</option>
                <option value="Female">Female</option>
            </InputSelect>
        </div>

        <div class="form">
            <label>Weight (lbs):</label>
            <InputNumber @bind-Value="input.Weight" />
        </div>

        <div class="form">
            <label>Height:</label>
            <div class="height-inputs">
                <InputNumber @bind-Value="input.Feet" />
                <span class="unit">ft</span>

                <InputNumber @bind-Value="input.Inches" />
                <span class="unit">in</span>
            </div>
        </div>

        <div class="form">
            <label>Age (years):</label>
            <InputNumber @bind-Value="input.Age" />
        </div>

        <div class="form">
            <label>Choose Activity Level:</label>
            <InputSelect @bind-Value="input.ActivityLevel">
                <option value="1">Low Activity (Little to no planned exercise)</option>
                <option value="2">Medium Activity (Exercise 2-4 days per week)</option>
                <option value="3">High Activity (Exercise 5-7 days per week or an active job)</option>
            </InputSelect>
        </div>

        <ValidationSummary />

        @if (prefilled)
        {
            <p class="prefill-note">
                Prefilled from your <a href="profile">profile</a>.
            </p>
        }

        <button type="submit" class="form-calc">Calculate</button>
    </div>
</EditForm>

@if (result != null)
{
    <div class="results">
        <hr />

        <h3 class="underline">Daily Calories</h3>

        <p class="lose"><strong>Lose Weight:</strong> @result.Lose.ToString("F0") calories/day</p>

        <p class="maintain"><strong>Maintain Weight:</strong> @result.Maintain.ToString("F0") calories/day</p>

        <p class="gain"><strong>Gain Weight:</strong> @result.Gain.ToString("F0") calories/day</p>

        <hr />

        <h4>Set as my goal</h4>

        <p class="goal-help">
            Pick the one you want to track against. It shows on your dashboard
            and is included in your PDF report.
        </p>

        <div class="goal-buttons">
            @foreach (var option in goalOptions)
            {
                <button type="button"
                        class="@GoalButtonClass(option.GoalType)"
                        @onclick="() => SetGoal(option.GoalType, option.Calories)">
                    @option.GoalType
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <p class="goal-status">@statusMessage</p>
        }
    </div>
}

@code {
    private CalculatorInput input = new();
    private CalorieResult? result;

    private User? currentUser;
    private CalorieGoal? currentGoal;

    private bool prefilled;

    private List<GoalOption> goalOptions = new();
    private string statusMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        currentUser =
            await UserService.GetUserByPrincipalAsync(authState.User);

        if (currentUser == null)
        {
            return;
        }

        currentGoal =
            await DbContext.CalorieGoals
                .FirstOrDefaultAsync(c => c.UserId == currentUser.UserId);

        // Prefill the form from the saved profile so the user does not
        // have to type the same numbers twice.
        if (currentUser.Weight > 0)
        {
            input.Weight = currentUser.Weight;
            prefilled = true;
        }

        if (currentUser.Height > 0)
        {
            // Height is stored as total inches.
            input.Feet = (int)(currentUser.Height / 12);
            input.Inches = (int)Math.Round(currentUser.Height % 12);
            prefilled = true;
        }

        if (currentUser.Age > 0)
        {
            input.Age = currentUser.Age;
            prefilled = true;
        }
    }

    private void Calculate()
    {
        // Convert to metric
        double weightKg = input.Weight * 0.453592;
        double heightCm = (input.Feet * 30.48) + (input.Inches * 2.54);

        // Mifflin-St Jeor BMR
        double bmr;

        if (input.Gender == "Male")
        {
            bmr = (10 * weightKg) + (6.25 * heightCm) - (5 * input.Age) + 5;
        }
        else
        {
            bmr = (10 * weightKg) + (6.25 * heightCm) - (5 * input.Age) - 161;
        }

        double activityMultiplier = input.ActivityLevel switch
        {
            1 => 1.25,
            2 => 1.45,
            3 => 1.68,
            _ => 1.20
        };

        double maintenance = bmr * activityMultiplier;

        result = new CalorieResult
        {
            Lose = maintenance - 500,
            Maintain = maintenance,
            Gain = maintenance + 500
        };

        goalOptions = new List<GoalOption>
        {
            new GoalOption(GoalTypes.Lose, result.Lose),
            new GoalOption(GoalTypes.Maintain, result.Maintain),
            new GoalOption(GoalTypes.Gain, result.Gain)
        };

        statusMessage = "";
    }

    private string GoalButtonClass(string goalType)
    {
        var isCurrent =
            currentGoal != null && currentGoal.GoalType == goalType;

        return isCurrent ? "goal-btn goal-btn-active" : "goal-btn";
    }

    private async Task SetGoal(string goalType, double calories)
    {
        if (currentUser == null)
        {
            statusMessage = "Could not find your account. Try signing in again.";
            return;
        }

        // One active goal per user, matching what the dashboard reads.
        var goal =
            await DbContext.CalorieGoals
                .FirstOrDefaultAsync(c => c.UserId == currentUser.UserId);

        if (goal == null)
        {
            goal = new CalorieGoal
            {
                UserId = currentUser.UserId
            };

            DbContext.CalorieGoals.Add(goal);
        }

        goal.GoalType = goalType;
        goal.DailyCalories = (int)Math.Round(calories);

        await DbContext.SaveChangesAsync();

        currentGoal = goal;

        statusMessage =
            $"Saved. Your goal is {GoalTypes.ToDisplayName(goal.GoalType)} " +
            $"at {goal.DailyCalories} cal/day.";
    }

    public class CalculatorInput
    {
        public string Gender { get; set; } = "Male";

        [Range(50, 1000, ErrorMessage = "Enter a weight between 50 and 1000 lbs.")]
        public double Weight { get; set; }

        [Range(1, 8, ErrorMessage = "Feet must be between 1 and 8.")]
        public double Feet { get; set; }

        [Range(0, 11, ErrorMessage = "Inches must be 0-11 \u2014 enter only the leftover inches (5 ft 9 in, not 69).")]
        public double Inches { get; set; }

        [Range(13, 120, ErrorMessage = "Enter an age between 13 and 120.")]
        public int Age { get; set; }

        public int ActivityLevel { get; set; } = 1;
    }

    public record GoalOption(string GoalType, double Calories);

    public class CalorieResult
    {
        public double Lose { get; set; }

        public double Maintain { get; set; }

        public double Gain { get; set; }
    }
}
